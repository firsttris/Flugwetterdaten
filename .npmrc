# npm 12 lehnt mit allow-remote=none (sein neuer Standard) Tarball-URLs ab. Beim Schreiben nur der
# Lockdatei (npm install --package-lock-only, so aktualisiert Renovate sie) öffnet npm aber Pakete
# mit gebündelten Abhängigkeiten über ihre registry-URL, etwa @tailwindcss/oxide-wasm32-wasi, und
# bricht mit EALLOWREMOTE ab (npm/cli, workspaces/arborist/lib/arborist/build-ideal-tree.js,
# "crackOpen"). "root" reicht dafür nicht; "all" ist das Verhalten von npm 11.
allow-remote=all
